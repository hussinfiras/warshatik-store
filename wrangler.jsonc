{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "warshatik-store2",
  "main": "worker.js",
  "compatibility_date": "2026-10-04",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "warshatik-store-db",
      "database_id": "52444ab9-800c-455a-b4da-8c687183a41e"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "warshatik-media"
    }
  ]
}