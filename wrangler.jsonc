{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "warshatik-store2",
  "main": "worker.js",
  "compatibility_date": "2026-10-04",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "warshatik-store-db"
    }
  ]
}